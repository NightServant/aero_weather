# AeroWeather runs with no configuration at all: Open-Meteo, BigDataCloud and
# Wikimedia are key-less. Both variables below are optional and affect
# deployment only. Copy this file to .env.local and fill in what you need.

# Absolute origin of the deployed site. robots.txt, sitemap.xml and the Open
# Graph tags build their URLs from it; without it they fall back to
# https://aeroweather.app, which is a placeholder, so set this before shipping
# or search engines and link previews will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Google Analytics 4 measurement id. Leave unset and Google Analytics stays
# dormant and the consent prompt never appears, which is the correct state
# until you have one. Vercel Analytics is cookieless and runs regardless.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
